# Copy to .env and fill in. Leave MECM_SQL_SERVER empty to run against the built-in sample fleet.

# Site database server. Accepts HOST, HOST\INSTANCE or HOST,PORT.
MECM_SQL_SERVER=
# Site database name: CM_<site code>.
MECM_SQL_DATABASE=CM_PS1

# windows = Integrated auth as the account running the server (Windows only, uses msnodesqlv8 + ODBC Driver 18)
# sql     = SQL login (MECM_SQL_USER / MECM_SQL_PASSWORD)
# ntlm    = domain account from any OS (MECM_SQL_DOMAIN / MECM_SQL_USER / MECM_SQL_PASSWORD)
MECM_SQL_AUTH=windows
MECM_SQL_USER=
MECM_SQL_PASSWORD=
MECM_SQL_DOMAIN=

# ODBC driver used for Windows auth.
MECM_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MECM_SQL_ENCRYPT=true
# Certificates are validated by default. If the site database uses SQL Server's self-signed certificate, install
# a CA-issued certificate or trust its CA on this machine. Setting true skips validation and allows interception.
MECM_SQL_TRUST_SERVER_CERT=false
MECM_SQL_TIMEOUT_SECONDS=120

# Live results are cached per query and parameter set; the header refresh button bypasses the cache.
MECM_CACHE_SECONDS=300
MECM_MAX_ROWS=250000

# The server has no authentication of its own. Keep HOST on 127.0.0.1 unless it sits behind an authenticating proxy.
HOST=127.0.0.1
PORT=4173
# Requests must be addressed to localhost, 127.0.0.1 or HOST; any other host name is refused (DNS rebinding protection).
# Behind a proxy, list the host names it forwards, comma-separated.
ALLOWED_HOSTS=
